# ==========================================
# Frontend environment variables (Vite)
# Copy this file to `.env` and fill in real values, then restart `npm run dev`.
# Only variables prefixed with VITE_ are exposed to the browser.
# ==========================================

# Razorpay publishable Key ID for the fee-payment checkout (students & parents).
# Get it from Razorpay Dashboard → Settings → API Keys.
# Use a TEST key (rzp_test_…) for development; a LIVE key (rzp_live_…) in production.
# NOTE: only the Key ID goes here. The Key SECRET must NEVER be put in the
# frontend — it belongs on the backend for order creation & signature verification.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Optional: override the backend API base URL (defaults to window origin /api/v1).
# VITE_API_URL=http://127.0.0.1:5000/api/v1

# Demo quick-login buttons on the sign-in page. They contain real passwords of
# the seeded demo accounts, so they are OFF in production builds. Set to true
# only for a dedicated demo deployment whose database holds no real data.
# VITE_ENABLE_DEMO_LOGIN=false

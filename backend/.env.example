FLASK_APP=wsgi.py
FLASK_ENV=development
# Required, long random values (the app refuses to start with empty/placeholder
# secrets). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Security --------------------------------------------------------------
# Frontend and API on different sites (e.g. Vercel + Render)? Use None so the
# browser sends the refresh cookie cross-site (it is then always Secure/HTTPS).
REFRESH_COOKIE_SAMESITE=Lax
# Reverse proxies in front of the API (Render/Heroku/Nginx: 1). Lets rate limits
# and audit logs see real client IPs. Keep 0 when nothing sits in front of it.
TRUSTED_PROXY_COUNT=0
# Lock an account after this many failed logins, for this many minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Werkzeug debugger for `python wsgi.py` (development only, binds to 127.0.0.1).
FLASK_DEBUG=0

# --- Database (PostgreSQL) ------------------------------------------------
# true: connect to PostgreSQL (DATABASE_URL required). false: DB endpoints return 503.
DATABASE_ENABLED=true
# PRIMARY: Supabase (Session pooler) — Dashboard > Project Settings > Database
#          > Connection string > "Session pooler". Change postgresql:// to postgresql+psycopg2://
# DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# FUTURE (GCP Cloud SQL) — to migrate later, replace the single line above with:
# DATABASE_URL=postgresql+psycopg2://USER:PASS@/school_erp?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# --- Redis (caching / rate-limiting / realtime) ---------------------------
# Optional but recommended for production speed. When set, API read responses
# are cached, rate-limiting is shared across workers, and SocketIO events fan
# out across processes. Leave blank to fall back to in-process memory.
# Local:  redis://localhost:6379/0
# Cloud:  rediss://default:<PASSWORD>@<HOST>:<PORT>   (managed Redis, TLS)
REDIS_URL=

# --- Development authentication -------------------------------------------
# Database-free login using dev_auth_accounts.json (Argon2id hashes, git-ignored).
# Only honoured while DATABASE_ENABLED=false; startup fails if set in production.
DEV_AUTH_ENABLED=false
# DEV_AUTH_ACCOUNTS_FILE=dev_auth_accounts.json

# --- SMS delivery (credentials / notifications) ---------------------------
# Provider for real SMS: console (default = no real send, logs to outbox),
# msg91, or fast2sms. Until a provider + keys are set, the UI will honestly
# report "SMS Not Sent" instead of falsely claiming delivery.
SMS_PROVIDER=console
# 6-char DLT-approved sender/header, e.g. STXAVR
SMS_SENDER_ID=
SCHOOL_NAME=St. Xavier's Academy
FRONTEND_URL=http://localhost:5173

# MSG91 (https://control.msg91.com) — requires a DLT-approved Flow template
# whose variables map to name / login id / password.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Fast2SMS (https://www.fast2sms.com)
# FAST2SMS_ROUTE=dlt needs FAST2SMS_SENDER_ID + FAST2SMS_MESSAGE_ID (DLT template id).
# FAST2SMS_ROUTE=q is the quick-SMS route for testing only.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_MESSAGE_ID=

# --- Online fee payments (Razorpay) -----------------------------------------
# PAYMENT_MODE: auto (default) = live when both keys are set, otherwise disabled;
#   live = real Razorpay Checkout (startup fails without both keys; an rzp_test_
#          key is Razorpay's sandbox and is labelled TEST);
#   mock = simulated gateway for development/demo only (no money moves, every
#          receipt says TEST PAYMENT); disabled = online payment switched off.
PAYMENT_MODE=auto
# Dashboard > Account & Settings > API Keys. The Key Secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL {API}/api/v1/payments/razorpay/webhook, events
# payment.authorized, payment.captured, payment.failed, order.paid,
# refund.processed, refund.failed. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=
# Optional local logo file (PNG/JPEG) for PDF receipts; defaults to app/static/receipt_logo.png.
RECEIPT_LOGO_PATH=
